{
	"name": "foobar-style-chooser",
	"version": "6.0.0",
	"description": "Style chooser for foobar2000 tracks",
	"keywords": [
		"foobar",
		"style",
		"chooser"
	],
	"author": "Anatoliy Oblaukhov",
	"homepage": "https://github.com/anmiles/foobar-style-chooser",
	"repository": "github:anmiles/foobar-style-chooser",
	"license": "MIT",
	"engines": {
		"node": ">=24.18.0"
	},
	"scripts": {
		"spellcheck": "cspell .",
		"prebuild": "tsc -noEmit",
		"build": "vite build",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"test": "jest --verbose",
		"test:coverage": "npm test -- --coverage",
		"test:ci": "npm test -- --ci --coverage",
		"test:watch": "npm test -- --watch",
		"test:watch:coverage": "npm test -- --watch --coverage",
		"test:report:coverage": "nyc report",
		"start": "node ./server.mjs",
		"dev": "vite",
		"preview": "vite preview --open"
	},
	"dependencies": {
		"@anmiles/express-tools": "^3.0.0",
		"classnames": "^2.5.1",
		"express": "^5.2.1",
		"out-url": "^1.3.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@anmiles/eslint-config": "^11.0.0",
		"@anmiles/tsconfig": "^5.0.0",
		"@eslint/compat": "^2.1.1",
		"@eslint/css": "^2.0.0",
		"@eslint/js": "^9.39.5",
		"@eslint/json": "^2.1.0",
		"@eslint/markdown": "^8.0.3",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/react": "^19.0.12",
		"@types/react-dom": "^19.0.4",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"@vitejs/plugin-react": "^6.1.1",
		"ajv": "^8.20.0",
		"cspell": "^10.3.3",
		"eslint": "^9.39.2",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-align-assignments": "^1.1.2",
		"eslint-plugin-i18next": "^6.1.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jest": "^29.16.6",
		"eslint-plugin-n": "^18.3.0",
		"eslint-plugin-promise": "^7.3.0",
		"jest": "^30.5.1",
		"jest-environment-jsdom": "^30.5.1",
		"jiti": "^2.7.0",
		"nyc": "^18.0.0",
		"ts-jest": "^29.4.12",
		"typescript": "^6.0.3",
		"use-immer": "^0.11.0",
		"vite": "^8.3.0"
	}
}
